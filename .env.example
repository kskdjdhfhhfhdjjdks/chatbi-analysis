# ============================================================
# 环境变量模板
#
# 本地：复制本文件为 .env，填入真实 Key。.env 已被 .gitignore 排除，不会入库。
# 线上：在 Netlify 后台 Site configuration → Environment variables 里配置同名变量。
#
# 注意：变量名不要加 VITE_ 前缀。
# 加前缀的变量会被 Vite 打包进浏览器代码，等于把密钥公开。
# ============================================================

DEEPSEEK_API_KEY=

# 可选：默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：默认 deepseek-flash（语义解析要的是快和稳，不需要长链推理）
DEEPSEEK_MODEL=deepseek-flash
